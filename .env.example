# Salin file ini jadi ".env" lalu isi nilainya.

# Port server (biasanya platform hosting akan set ini otomatis, boleh dibiarkan)
PORT=3000

# WAJIB diisi dengan teks acak yang panjang & rahasia (untuk mengamankan sesi login).
# Contoh cara bikin di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set "production" kalau dideploy dengan HTTPS (supaya cookie login lebih aman)
NODE_ENV=production

# ---- Shopee Open Platform API (§10/§19 PROJECT_NOTES.md) ----
# "sandbox" = Test Partner ID/Key, data toko palsu (tahap sekarang, sebelum App di-Go Live).
# "production" = Live Partner ID/Key, data toko ASLI — baru dipakai setelah Go Live disetujui.
SHOPEE_ENV=sandbox

# Didapat dari Shopee Open Platform Console setelah bikin App (tipe "Seller In-house System").
# JANGAN commit nilai asli — file .env sudah di-gitignore, hanya .env.example ini yang boleh kosong.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Harus SAMA PERSIS dengan Redirect URL Domain yang didaftarkan di Console, KALAU sudah
# didaftarkan (kalau belum, Shopee belum mengecek domainnya sama sekali, jadi localhost
# di bawah ini aman dipakai untuk tes lokal dulu).
SHOPEE_REDIRECT_URL=http://localhost:3000/auth/shopee/callback
