# Salin file ini jadi ".env" lalu isi nilainya.

# Port server (biasanya platform hosting akan set ini otomatis, boleh dibiarkan)
PORT=3000

# WAJIB diisi dengan teks acak yang panjang & rahasia (untuk mengamankan sesi login).
# Contoh cara bikin di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set "production" kalau dideploy dengan HTTPS (supaya cookie login lebih aman)
NODE_ENV=production
